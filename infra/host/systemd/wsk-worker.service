[Unit]
Description=Window Sticker worker (runs crash tests in microVMs)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=wsk
SupplementaryGroups=kvm
WorkingDirectory=/home/wsk/window-sticker/backend
EnvironmentFile=/home/wsk/window-sticker/.env
ExecStart=/home/wsk/.local/bin/uv run --no-sync windowsticker worker
Restart=always
RestartSec=5
# In-flight microVMs end on their own: each has a runtime-enforced max_duration.
TimeoutStopSec=60
# The worker needs /dev/kvm and its own storage, so it is hardened less than the API, but it
# still cannot gain privileges or touch system files, and the memory cap bounds every microVM
# it starts (they run in this unit's cgroup).
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=7G

[Install]
WantedBy=multi-user.target
