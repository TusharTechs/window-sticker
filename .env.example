# Copy to .env (git-ignored) and fill in. Never commit real values.

# Vultr Serverless Inference (Compute -> Serverless Inference -> your subscription)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Vultr platform API (Orchestration -> Vultr API). Used for instances, firewall groups, tags, billing.
VULTR_API_KEY=
VULTR_API_BASE_URL=https://api.vultr.com/v2

# Control plane
WSK_DATABASE_URL=postgresql+asyncpg://windowsticker:windowsticker@localhost:5432/windowsticker
WSK_ARTIFACT_DIR=./artifacts

# Sandbox host
WSK_SANDBOX_IMAGE=python
WSK_WARDEN_LISTEN=127.0.0.1:8899
